{{- $items := slice -}}
{{- range site.RegularPages -}}
  {{- $section := .Section -}}
  {{- if and (in (slice "posts" "projects" "resources") $section) (not .Params.searchExclude) -}}
    {{- $kind := "项目" -}}
    {{- if eq $section "posts" -}}
      {{- $kind = "文章" -}}
    {{- else if eq $section "resources" -}}
      {{- $kind = "资源" -}}
    {{- end -}}
    {{- $date := "" -}}
    {{- if ne $kind "项目" -}}
      {{- $date = .Date.Format "2006-01-02" -}}
    {{- end -}}
    {{- $items = $items | append (dict
      "title" .LinkTitle
      "url" .RelPermalink
      "date" $date
      "summary" (.Description | default (.Summary | plainify))
      "content" (.Plain | htmlUnescape)
      "tags" (.Params.tags | default (slice))
      "kind" $kind
    ) -}}
  {{- end -}}
{{- end -}}
{{- $items | jsonify -}}
